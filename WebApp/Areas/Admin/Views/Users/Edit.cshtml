@model AdminUserEditViewModel

<h1 class="h3 mb-4">@L["EditUser"]</h1>

<form asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input asp-for="Id" type="hidden"/>
        <div class="mb-3">
            <label class="form-label">@L["Email"]</label>
            <input asp-for="Email" type="hidden"/>
            <input class="form-control" value="@Model.Email" disabled/>
        </div>
        <div class="mb-3">
            <label asp-for="Role" class="form-label">@L["Role"]</label>
            @if (Model.IsSelf)
            {
                <input asp-for="Role" type="hidden"/>
                <input class="form-control" value="@Model.CurrentRole" disabled/>
                <div class="form-text">@L["CannotChangeOwnRole"]</div>
            }
            else
            {
                <select asp-for="Role" class="form-select">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            }
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <div class="form-check">
            @if (Model.IsSelf)
            {
                <input asp-for="IsActive" class="form-check-input" disabled/>
                <input asp-for="IsActive" type="hidden"/>
            }
            else
            {
                <input asp-for="IsActive" class="form-check-input"/>
            }
            <label asp-for="IsActive" class="form-check-label">@L["Active"]</label>
            <span asp-validation-for="IsActive" class="text-danger d-block"></span>
            @if (Model.IsSelf)
            {
                <div class="form-text">@L["CannotDeactivateSelf"]</div>
            }
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">@L["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@L["SaveChanges"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
