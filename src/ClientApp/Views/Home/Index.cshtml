@model HomeIndexViewModel

<div class="bb-hero">
    <h1 class="bb-hero-title">@L["HeroTitle"]</h1>
    <p class="bb-hero-sub">@L["HeroSubtitle"]</p>
    <div class="bb-search-wrap">
        <form method="get" asp-action="Index" class="bb-search-bar">
            <input type="hidden" name="filter"        value="@Model.Filter" />
            <input type="hidden" name="serviceTypeId" value="@Model.ServiceTypeId" />
            <i class="ti ti-search bb-search-icon" aria-hidden="true"></i>
            <input type="text" name="search" value="@Model.Search"
                   class="bb-search-input" placeholder="@L["SearchByName"]" />
            <button type="submit" class="bb-search-btn">@L["Search"]</button>
        </form>
    </div>
    <div class="bb-steps">
        <div class="bb-step"><span class="bb-step-dot bb-dot-pink">1</span>@L["StepBrowse"]</div>
        <div class="bb-step"><span class="bb-step-dot bb-dot-lavender">2</span>@L["StepCompare"]</div>
        <div class="bb-step"><span class="bb-step-dot bb-dot-mint">3</span>@L["StepConfirm"]</div>
    </div>
</div>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <div class="btn-group bb-filter-group" role="group">
            <a href="@Url.Action("Index", "Home", new { serviceTypeId = Model.ServiceTypeId, search = Model.Search })"
               class="btn btn-@(Model.Filter == "all" ? "primary" : "outline-primary")">@L["AllProviders"]</a>
            <a href="@Url.Action("Index", "Home", new { filter = "independent", serviceTypeId = Model.ServiceTypeId, search = Model.Search })"
               class="btn btn-@(Model.Filter == "independent" ? "primary" : "outline-primary")">@L["Independent"]</a>
        </div>
    </div>
    <div class="col-auto">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="hidden" name="filter" value="@Model.Filter"/>
            <input type="hidden" name="serviceTypeId" value="@Model.ServiceTypeId"/>
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm"
                   placeholder="@L["SearchByName"]" style="width:180px"/>
            <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Search"]</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a href="@Url.Action("Index", "Home", new { filter = Model.Filter, serviceTypeId = Model.ServiceTypeId })"
                   class="btn btn-sm btn-outline-secondary">✕</a>
            }
        </form>
    </div>
</div>

@if (Model.ServiceTypes.Any())
{
    <div class="d-flex flex-wrap gap-2 mb-3 bb-service-pills">
        <a href="@Url.Action("Index", "Home", new { filter = Model.Filter, search = Model.Search })"
           class="btn btn-sm btn-@(Model.ServiceTypeId == null ? "dark" : "outline-dark")">@L["AllServiceTypes"]</a>
        @foreach (var t in Model.ServiceTypes)
        {
            <a href="@Url.Action("Index", "Home", new { filter = Model.Filter, serviceTypeId = t.Id, search = Model.Search })"
               class="btn btn-sm btn-@(Model.ServiceTypeId == t.Id ? "dark" : "outline-dark")">@t.Name</a>
        }
    </div>
}

@if (!Model.Providers.Any())
{
    <div class="alert alert-info">@L["NoRows"]</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var provider in Model.Providers)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@provider.ProfileName</h5>
                        <p class="card-text text-muted small">@provider.Address</p>
                        <p class="card-text">
                            <span><span class="bb-rating-star">&#9733;</span> @provider.AverageRating.ToString("0.0")</span>
                            &nbsp;&bull;&nbsp;
                            <span class="text-success">@provider.TodayAvailabilityCount @L["SlotsToday"]</span>
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-controller="Providers" asp-action="Details" asp-route-id="@provider.Id"
                           class="btn btn-sm btn-outline-primary">@L["Details"]</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.Salons.Any())
{
    <hr class="my-4" />
    <h2 class="bb-salons-heading">@L["Salons"]</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var salon in Model.Salons)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(salon.ProfilePictureUrl))
                    {
                        <img src="@salon.ProfilePictureUrl" class="card-img-top" alt="@salon.Name"
                             style="height:180px;object-fit:cover" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@salon.Name</h5>
                        <p class="card-text text-muted small">@salon.Address</p>
                        <p class="card-text small">
                            <span class="text-secondary">@L["SalonStaff"]: @salon.StaffCount</span>
                        </p>
                    </div>
                    <div class="card-footer">
                        <a asp-controller="Salons" asp-action="Details" asp-route-id="@salon.Id"
                           class="btn btn-outline-primary btn-sm w-100">@L["Details"]</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
