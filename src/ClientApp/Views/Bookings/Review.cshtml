@model ReviewCreateViewModel

<h2 class="mb-1">@L["LeaveReview"]</h2>
<p class="text-muted mb-4">
    @Model.ProviderName &mdash; @Model.ServiceName &mdash; @Model.AppointmentDateTime.ToString("f")
</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@L["ReviewError"]</div>
}

<form asp-action="Review" method="post" style="max-width: 480px;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BookingId" value="@Model.BookingId" />
    <input type="hidden" name="ServiceName" value="@Model.ServiceName" />
    <input type="hidden" name="ProviderName" value="@Model.ProviderName" />
    <input type="hidden" name="AppointmentDateTime" value="@Model.AppointmentDateTime.ToString("o")" />

    <div class="mb-3">
        <label class="form-label fw-semibold">@L["Rating"]</label>
        <div class="d-flex gap-2">
            @for (int i = 1; i <= 5; i++)
            {
                var starId = $"star-{i}";
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Rating" id="@starId"
                           value="@i" @(Model.Rating == i ? "checked" : "") required />
                    <label class="form-check-label fs-5" for="@starId">@i &#9733;</label>
                </div>
            }
        </div>
        <span asp-validation-for="Rating" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Comment" class="form-label fw-semibold">@L["Comment"]</label>
        <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Optional..."></textarea>
    </div>

    <button type="submit" class="btn btn-success">@L["SubmitReview"]</button>
    <a asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary ms-2">@L["Back"]</a>
</form>
