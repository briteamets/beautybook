@model SalonDetailsViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["SalonDetails"]</h1>
        <p class="text-muted mb-0">@Model.NameEn</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">@L["Edit"]</a>
        <a class="btn btn-outline-dark" asp-action="Index">@L["Back"]</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">@L["Content"]</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">@L["NameEn"]</dt>
                    <dd class="col-sm-8">@Model.NameEn</dd>
                    <dt class="col-sm-4">@L["NameEt"]</dt>
                    <dd class="col-sm-8">@Model.NameEt</dd>
                    <dt class="col-sm-4">@L["DescriptionEn"]</dt>
                    <dd class="col-sm-8">@Model.DescriptionEn</dd>
                    <dt class="col-sm-4">@L["DescriptionEt"]</dt>
                    <dd class="col-sm-8">@Model.DescriptionEt</dd>
                    <dt class="col-sm-4">@L["Address"]</dt>
                    <dd class="col-sm-8">@Model.Address</dd>
                    <dt class="col-sm-4">@L["Coordinates"]</dt>
                    <dd class="col-sm-8">@Model.Latitude, @Model.Longitude</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">@L["Staff"]</h2>
                @if (Model.Staff.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var member in Model.Staff)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span>@member.ProviderName</span>
                                <span class="text-muted">@member.Role</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">@L["NoStaffMembersLinked"]</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">@L["SalonOwners"]</h2>
                @if (Model.Owners.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var owner in Model.Owners)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3">
                                <div>
                                    <div>@owner.Email</div>
                                    <div class="text-muted small">@owner.UserName</div>
                                </div>
                                <form asp-action="RemoveOwner" asp-route-id="@Model.Id" method="post">
                                    <input type="hidden" name="salonOwnerId" value="@owner.SalonOwnerId"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@L["ConfirmRemoveSalonOwner"]');">@L["Remove"]</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">@L["NoSalonOwnersLinked"]</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">@L["AssignSalonOwner"]</h2>
                @if (Model.AssignOwner.UserOptions.Any())
                {
                    <form asp-action="AssignOwner" asp-route-id="@Model.Id" method="post" class="row g-3">
                        <input asp-for="AssignOwner.SalonId" type="hidden"/>
                        <div class="col-12">
                            <label asp-for="AssignOwner.UserId" class="form-label">@L["SalonOwner"]</label>
                            <select asp-for="AssignOwner.UserId" asp-items="Model.AssignOwner.UserOptions" class="form-select"></select>
                            <span asp-validation-for="AssignOwner.UserId" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">@L["AssignSalonOwner"]</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted mb-0">@L["NoAssignableSalonOwners"]</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
