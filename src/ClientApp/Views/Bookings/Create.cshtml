@model BookingCreateViewModel

<h1>@L["Create"] @L["Bookings"]</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="ServiceId" class="form-label">@L["Service"]</label>
        <select asp-for="ServiceId" class="form-select">
            @foreach (var service in Model.Services)
            {
                <option value="@service.Id">@service.Label</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="AvailabilityId" class="form-label">@L["AvailabilityId"]</label>
        <select asp-for="AvailabilityId" class="form-select">
            @foreach (var slot in Model.AvailabilitySlots)
            {
                <option value="@slot.Id">@slot.Label</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label">@L["Notes"]</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">@L["Save"]</button>
    <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
</form>
