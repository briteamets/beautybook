@model ServiceTypeFormViewModel
@{
    var formAction = ViewData["FormAction"]?.ToString();
    var submitLabel = ViewData["SubmitLabel"]?.ToString() ?? L["Save"].Value;
}

<form asp-action="@formAction" method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="Id" type="hidden"/>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ServiceCategoryId" class="form-label">@L["Category"]</label>
                <select asp-for="ServiceCategoryId" asp-items="Model.Categories" class="form-select"></select>
                <span asp-validation-for="ServiceCategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input asp-for="IsActive" class="form-check-input"/>
                    <label asp-for="IsActive" class="form-check-label">@L["Active"]</label>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="Name.En" class="form-label">@L["NameEn"]</label>
                <input asp-for="Name.En" class="form-control"/>
                <span asp-validation-for="Name.En" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Name.Et" class="form-label">@L["NameEt"]</label>
                <input asp-for="Name.Et" class="form-control"/>
                <span asp-validation-for="Name.Et" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description.En" class="form-label">@L["DescriptionEn"]</label>
                <textarea asp-for="Description.En" class="form-control" rows="4"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="Description.Et" class="form-label">@L["DescriptionEt"]</label>
                <textarea asp-for="Description.Et" class="form-control" rows="4"></textarea>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@submitLabel</button>
    </div>
</form>
