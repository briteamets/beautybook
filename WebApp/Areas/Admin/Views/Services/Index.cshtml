@model AdminServiceIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["ProviderServices"]</h1>
        <p class="text-muted mb-0">@L["ProviderServicesAdminHelp"]</p>
    </div>
    <span class="badge bg-secondary">@L["TotalCount", Model.Page.TotalItems]</span>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="providerId">@L["Provider"]</label>
            <select class="form-select" id="providerId" name="providerId">
                <option value="">@L["All"]</option>
                @foreach (var p in Model.Providers)
                {
                    <option value="@p.Value" selected="@(p.Selected ? "selected" : null)">@p.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="categoryId">@L["Category"]</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">@L["All"]</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Value" selected="@(c.Selected ? "selected" : null)">@c.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="isActive">@L["Status"]</label>
            <select class="form-select" id="isActive" name="isActive">
                <option value="">@L["All"]</option>
                <option value="true" selected="@(Model.Filter.IsActive == true ? "selected" : null)">@L["Active"]</option>
                <option value="false" selected="@(Model.Filter.IsActive == false ? "selected" : null)">@L["Inactive"]</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">@L["Filter"]</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>@L["ServiceName"]</th>
                <th>@L["Category"]</th>
                <th>@L["Provider"]</th>
                <th>@L["Price"]</th>
                <th>@L["Duration"]</th>
                <th>@L["Status"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Page.Items.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-3">@L["NoResults"]</td>
                </tr>
            }
            @foreach (var item in Model.Page.Items)
            {
                <tr>
                    <td>@item.ServiceName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.ProviderName</td>
                    <td>@item.Price</td>
                    <td>@item.DurationMinutes @L["Min"]</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                            @(item.IsActive ? L["Active"] : L["Inactive"])
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml" model="Model.Page"/>
</div>
