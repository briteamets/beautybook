@model ProviderDetailsViewModel

<h1>@Model.ProfileName</h1>
<dl class="row">
    <dt class="col-sm-3">@L["Address"]</dt>
    <dd class="col-sm-9">@Model.Address</dd>
    <dt class="col-sm-3">@L["Bio"]</dt>
    <dd class="col-sm-9">@Model.Bio</dd>
    <dt class="col-sm-3">@L["Status"]</dt>
    <dd class="col-sm-9">@Model.AverageRating / 5 (@Model.ReviewCount)</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">@L["Edit"]</a>
<a class="btn btn-outline-secondary" asp-action="Index">@L["Back"]</a>
