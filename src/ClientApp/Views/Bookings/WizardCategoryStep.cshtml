@model WizardCategoryStepViewModel

@if (!string.IsNullOrWhiteSpace(Model.SalonName))
{
    <p class="mb-3"><span class="badge bg-info text-dark fs-6">@Model.SalonName</span></p>
}

<h2 class="mb-4">@L["ChooseCategory"]</h2>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">@L["NoRows"]</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        @foreach (var category in Model.Categories)
        {
            <div class="col">
                <a asp-action="ServiceWizardTypes"
                   asp-route-categoryId="@category.Id"
                   asp-route-salonId="@Model.SalonId"
                   asp-route-salonName="@Model.SalonName"
                   class="card h-100 text-decoration-none text-dark category-card">
                    <div class="card-body d-flex align-items-center justify-content-center text-center py-4">
                        <h5 class="card-title mb-0">@category.Name</h5>
                    </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .category-card { transition: box-shadow .15s, transform .15s; cursor: pointer; }
    .category-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.12); transform: translateY(-2px); }
</style>
