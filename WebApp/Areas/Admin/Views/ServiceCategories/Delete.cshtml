@model ServiceCategory
<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h3">@L["DeleteServiceCategory"]</h1>
        <p class="text-muted">@L["DeleteServiceCategoryHelp"]</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">@L["NameEn"]</dt>
            <dd class="col-sm-9">@Model.Name.Translate("en")</dd>
            <dt class="col-sm-3">@L["NameEt"]</dt>
            <dd class="col-sm-9">@Model.Name.Translate("et")</dd>
        </dl>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id"/>
            <button type="submit" class="btn btn-danger">@L["Delete"]</button>
        </form>
    </div>
</div>
