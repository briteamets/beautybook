@page
@model WebApp.Areas.Identity.Pages.Account.RegisterModel
@using App.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedUiResource> L

<h1 class="h3 mb-4">@L["Register"]</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="card shadow-sm">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">@L["Email"]</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username"/>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">@L["Password"]</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password"/>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">@L["ConfirmPassword"]</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"/>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-check mb-2">
                    <input asp-for="Input.IsProviderApplicant" class="form-check-input"/>
                    <label asp-for="Input.IsProviderApplicant" class="form-check-label">@L["ApplyAsServiceProvider"]</label>
                </div>
                <p class="text-muted small mb-0">@L["ApplyAsServiceProviderHelp"]</p>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">@L["Register"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml"/>
}
