@model ProviderFormViewModel

<h1>@L["Create"] @L["Provider"]</h1>
<form asp-action="Create" method="post">
    <partial name="_ProviderForm" model="Model"/>
    <button type="submit" class="btn btn-primary">@L["Save"]</button>
    <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
</form>
