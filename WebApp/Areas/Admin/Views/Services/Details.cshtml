@model AdminServiceDetailsViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["ServiceDetails"]</h1>
        <p class="text-muted mb-0">@Model.ServiceName</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">@L["Back"]</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@L["ServiceName"]</dt>
            <dd class="col-sm-9">@Model.ServiceName</dd>
            <dt class="col-sm-3">@L["Category"]</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>
            <dt class="col-sm-3">@L["Provider"]</dt>
            <dd class="col-sm-9">
                <a asp-area="Admin" asp-controller="BeautyProviders" asp-action="Details" asp-route-id="@Model.ProviderId">@Model.ProviderName</a>
                @if (!string.IsNullOrWhiteSpace(Model.ProviderEmail))
                {
                    <span class="text-muted ms-2">(@Model.ProviderEmail)</span>
                }
            </dd>
            <dt class="col-sm-3">@L["Description"]</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "-")</dd>
            <dt class="col-sm-3">@L["Price"]</dt>
            <dd class="col-sm-9">@Model.Price</dd>
            <dt class="col-sm-3">@L["Duration"]</dt>
            <dd class="col-sm-9">@Model.DurationMinutes @L["Min"]</dd>
            <dt class="col-sm-3">@L["Status"]</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                    @(Model.IsActive ? L["Active"] : L["Inactive"])
                </span>
            </dd>
            <dt class="col-sm-3">@L["From"]</dt>
            <dd class="col-sm-9">@Model.From.ToLocalTime()</dd>
            @if (Model.To.HasValue)
            {
                <dt class="col-sm-3">@L["To"]</dt>
                <dd class="col-sm-9">@Model.To.Value.ToLocalTime()</dd>
            }
        </dl>
    </div>
</div>
