@model ServiceFormViewModel

<h2>@L["Create"] @L["Service"]</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="MyServiceCreate" method="post">
            <partial name="_MyServiceForm" model="Model"/>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-action="MyServices" class="btn btn-outline-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
