@model SalonOwnerDashboardViewModel

<h1 class="h3 mb-4">@L["SalonOwnerDashboard"]</h1>

@if (!Model.Salons.Any())
{
    <div class="alert alert-info">@L["NoOwnedSalons"]</div>
}
else
{
    <div class="row g-3">
        @foreach (var salon in Model.Salons)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5">@salon.Name</h2>
                        <p class="text-muted mb-3">@salon.Address</p>
                        <dl class="row mb-0">
                            <dt class="col-7">@L["Staff"]</dt>
                            <dd class="col-5 text-end">@salon.StaffCount</dd>
                            <dt class="col-7">@L["SalonServices"]</dt>
                            <dd class="col-5 text-end">@salon.ServiceCount</dd>
                            <dt class="col-7">@L["UpcomingBookings"]</dt>
                            <dd class="col-5 text-end">@salon.UpcomingBookingCount</dd>
                        </dl>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Salons" asp-action="Edit" asp-route-id="@salon.Id">@L["EditSalon"]</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Staff" asp-action="Index" asp-route-salonId="@salon.Id">@L["Staff"]</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Bookings" asp-action="Index" asp-route-salonId="@salon.Id">@L["Bookings"]</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
