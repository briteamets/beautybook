@{
    ViewData["Title"] = "Application Pending";
}

<div class="col-md-7 mx-auto text-center mt-5">
    <div class="display-1 mb-3">&#9203;</div>
    <h2>@L["ProviderPendingTitle"]</h2>
    <p class="lead text-muted mt-3">@L["ProviderPendingMessage"]</p>

    <div class="alert alert-info mt-4 text-start">
        <strong>@L["WhatHappensNext"]</strong>
        <ul class="mb-0 mt-2">
            <li>@L["ProviderPendingStep1"]</li>
            <li>@L["ProviderPendingStep2"]</li>
            <li>@L["ProviderPendingStep3"]</li>
        </ul>
    </div>

    <div class="alert alert-warning mt-3 text-start">
        <strong>@L["ProviderApprovalNoticeTitle"]</strong>
        <p class="mb-0 mt-1">@L["ProviderApprovalNoticeBody"]</p>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@L["BrowseProviders"]</a>
        <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary">@L["Bookings"]</a>
    </div>
</div>
