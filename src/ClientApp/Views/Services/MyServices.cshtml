@model MyServicesViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@L["MyServices"]</h2>
    @if (Model.HasProviderProfile)
    {
        <a asp-action="MyServiceCreate" asp-route-providerId="@Model.ProviderId"
           class="btn btn-primary">@L["Create"]</a>
    }
</div>

@if (!Model.HasProviderProfile)
{
    <div class="alert alert-warning">
        @L["NotAProvider"]
        <a asp-controller="Providers" asp-action="EditProfile" class="alert-link ms-1">@L["SetUpProfile"]</a>
    </div>
    return;
}

@if (!Model.Services.Any())
{
    <p class="text-muted">@L["NoRows"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["Name"]</th>
                    <th>@L["Category"]</th>
                    <th>@L["Price"]</th>
                    <th>@L["DurationMinutes"]</th>
                    <th>@L["Active"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Services)
                {
                    <tr class="@(s.IsActive ? "" : "text-muted")">
                        <td>@s.Name @if (!s.IsActive) { <span class="badge bg-secondary ms-1">inactive</span> }</td>
                        <td>@s.CategoryName</td>
                        <td>@s.Price.ToString("0.00") €</td>
                        <td>@s.DurationMinutes @L["Min"]</td>
                        <td>@(s.IsActive ? "✓" : "—")</td>
                        <td class="d-flex gap-1">
                            <a asp-action="MyServiceEdit" asp-route-id="@s.Id"
                               class="btn btn-sm btn-outline-primary">@L["Edit"]</a>
                            <a asp-action="MyServiceDelete" asp-route-id="@s.Id"
                               class="btn btn-sm btn-outline-danger">@L["Delete"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
