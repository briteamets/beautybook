@model WizardStep3ViewModel

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Wizard">@L["ChooseProvider"]</a></li>
        <li class="breadcrumb-item"><a asp-action="WizardStep2">@L["ChooseService"]</a></li>
        <li class="breadcrumb-item active">@L["ChooseDate"]</li>
    </ol>
</nav>

<h2 class="mb-1">@L["ChooseDate"]</h2>
<p class="text-muted mb-4">@Model.ProviderName &mdash; @Model.ServiceName</p>

<div class="mb-4" style="max-width: 320px;">
    <label class="form-label fw-semibold">@L["Date"]</label>
    <input type="date" id="dateInput" class="form-control"
           value="@Model.Date.ToString("yyyy-MM-dd")"
           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
</div>

@if (!Model.Slots.Any())
{
    <div class="alert alert-warning">@L["NoSlotsAvailable"]</div>
    <a asp-action="WizardStep2" class="btn btn-outline-secondary">@L["Back"]</a>
}
else
{
    <form asp-action="WizardStep4Post" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <p class="fw-semibold mb-2">@L["ChooseTimeSlot"]</p>
            @foreach (var slot in Model.Slots)
            {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="availabilityId"
                           id="slot-@slot.Id" value="@slot.Id" required />
                    <label class="form-check-label" for="slot-@slot.Id">
                        @slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")
                    </label>
                </div>
            }
        </div>

        <div class="mb-3" style="max-width: 480px;">
            <label class="form-label fw-semibold">@L["Notes"]</label>
            <textarea name="notes" class="form-control" rows="3">@Model.Notes</textarea>
        </div>

        <div class="mb-4 p-3 bg-light rounded d-inline-block">
            <strong>@L["Total"]:</strong> @Model.ServicePrice.ToString("0.00") EUR
        </div>

        <div>
            <button type="submit" class="btn btn-success">@L["ConfirmBooking"]</button>
            <a asp-action="WizardStep2" class="btn btn-outline-secondary ms-2">@L["Back"]</a>
        </div>
    </form>
}

@section Scripts {
    <script>
        document.getElementById('dateInput').addEventListener('change', function () {
            window.location.href = '@Url.Action("WizardStep3")' + '?date=' + this.value;
        });
    </script>
}
