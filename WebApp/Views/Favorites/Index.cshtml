@model FavoritesIndexViewModel
@{
    ViewData["Title"] = L["Favorites"];
}

<h1 class="h3 mb-4">@L["Favorites"]</h1>

@if (Model.Providers.Any())
{
    <div class="row g-4">
        @foreach (var provider in Model.Providers)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm h-100">
                    <img src="@(provider.ProfilePictureUrl ?? "https://placehold.co/600x320?text=Favorite")" class="card-img-top" alt="@provider.ProfileName"/>
                    <div class="card-body">
                        <h2 class="h5">@provider.ProfileName</h2>
                        <p class="text-muted">@provider.Address</p>
                        <p class="mb-3">Rating: @provider.AverageRating / 5</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary" asp-controller="ProviderProfile" asp-action="Details" asp-route-id="@provider.ProviderId">@L["ViewProfile"]</a>
                            <form asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@provider.FavoriteId"/>
                                <button type="submit" class="btn btn-outline-danger">@L["Remove"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-light border">@L["NoFavorites"]</div>
}
