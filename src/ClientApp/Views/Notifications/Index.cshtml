@model NotificationsIndexViewModel

<h2 class="mb-4">@L["Notifications"]</h2>

@if (!Model.Notifications.Any())
{
    <p class="text-muted">@L["NoNotifications"]</p>
}
else
{
    <div class="list-group">
        @foreach (var n in Model.Notifications)
        {
            <div class="list-group-item @(n.IsRead ? "" : "list-group-item-light border-start border-primary border-3")">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@n.Title</strong>
                        @if (!n.IsRead)
                        {
                            <span class="badge bg-primary ms-2">@L["New"]</span>
                        }
                        <p class="mb-1 text-muted">@n.Body</p>
                        <small class="text-muted">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </div>
                    @if (!n.IsRead)
                    {
                        <form asp-controller="Notifications" asp-action="MarkRead" method="post" class="ms-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@L["MarkAsRead"]</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
