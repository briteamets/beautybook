@model WizardStep1ViewModel

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">@L["ChooseProvider"]</h2>
    <a asp-action="ServiceWizard" class="btn btn-outline-primary">@L["BrowseByService"] &rarr;</a>
</div>

@if (!Model.Providers.Any())
{
    <div class="alert alert-info">@L["NoRows"]</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var provider in Model.Providers)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@provider.ProfileName</h5>
                        <p class="card-text text-muted small">@provider.Address</p>
                        <p class="card-text">
                            <span>&#9733; @provider.AverageRating.ToString("0.0")</span>
                            &nbsp;&bull;&nbsp;
                            <span class="text-success">@provider.TodayAvailabilityCount @L["SlotsToday"]</span>
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <form asp-action="WizardStep1Post" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="providerId" value="@provider.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">@L["Select"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
