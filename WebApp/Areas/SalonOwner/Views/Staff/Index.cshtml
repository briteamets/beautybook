@model SalonOwnerStaffIndexViewModel

<h1 class="h3 mb-4">@L["Staff"]</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label asp-for="SalonId" class="form-label">@L["Salon"]</label>
        <select asp-for="SalonId" asp-items="Model.SalonOptions" class="form-select">
            <option value="">@L["AllSalons"]</option>
        </select>
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary">@L["Filter"]</button>
    </div>
</form>

<div class="card shadow-sm mb-4">
    <div class="card-header">@L["AddProvider"]</div>
    <div class="card-body">
        @if (Model.SalonId.HasValue)
        {
            @if (Model.AddStaff.ProviderOptions.Any())
            {
                <form asp-action="Add" method="post" class="row g-2 align-items-end">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="AddStaff.SalonId" type="hidden"/>
                    <div class="col-md-6">
                        <label asp-for="AddStaff.BeautyProviderId" class="form-label">@L["ServiceProvider"]</label>
                        <select asp-for="AddStaff.BeautyProviderId" asp-items="Model.AddStaff.ProviderOptions" class="form-select"></select>
                        <span asp-validation-for="AddStaff.BeautyProviderId" class="text-danger"></span>
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-primary">@L["AddProvider"]</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">@L["NoAvailableProvidersForSalon"]</p>
            }
        }
        else
        {
            <p class="text-muted mb-0">@L["ChooseSalonBeforeAddingProvider"]</p>
        }
    </div>
</div>

@if (!Model.Staff.Any())
{
    <div class="alert alert-info">@L["NoStaffMembersLinked"]</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>@L["Salon"]</th>
            <th>@L["ServiceProvider"]</th>
            <th>@L["Email"]</th>
            <th>@L["Role"]</th>
            <th>@L["ActiveServices"]</th>
            <th>@L["Status"]</th>
            <th class="text-end">@L["Actions"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var staff in Model.Staff)
        {
            <tr>
                <td>@staff.SalonName</td>
                <td>@staff.ProviderName</td>
                <td>@staff.ProviderEmail</td>
                <td>@staff.Role</td>
                <td>@staff.ServiceCount</td>
                <td>
                    @if (staff.IsActive)
                    {
                        <span class="badge text-bg-success">@L["Active"]</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">@L["Inactive"]</span>
                    }
                </td>
                <td class="text-end">
                    <form asp-action="Remove" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@staff.SalonStaffId"/>
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@L["ConfirmRemoveProvider"]');">@L["RemoveProvider"]</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
