@model WizardServiceTypeStepViewModel

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-action="ServiceWizard"
               asp-route-salonId="@Model.SalonId"
               asp-route-salonName="@Model.SalonName">@L["ChooseCategory"]</a>
        </li>
        <li class="breadcrumb-item active">@Model.CategoryName</li>
    </ol>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.SalonName))
{
    <p class="mb-2"><span class="badge bg-info text-dark">@Model.SalonName</span></p>
}

<h2 class="mb-1">@L["ChooseServiceType"]</h2>
<p class="text-muted mb-4">@Model.CategoryName</p>

@if (!Model.ServiceTypes.Any())
{
    <div class="alert alert-info">@L["NoRows"]</div>
    <a asp-action="ServiceWizard"
       asp-route-salonId="@Model.SalonId"
       asp-route-salonName="@Model.SalonName"
       class="btn btn-outline-secondary">@L["Back"]</a>
}
else
{
    <div class="d-flex flex-wrap gap-2">
        @foreach (var st in Model.ServiceTypes)
        {
            <a asp-action="ServiceWizardProviders"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-serviceTypeId="@st.Id"
               asp-route-salonId="@Model.SalonId"
               asp-route-salonName="@Model.SalonName"
               class="btn btn-outline-primary">@st.Name</a>
        }
    </div>
}
