@model PagedViewModel<Review>
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["Reviews"]</h1>
        <p class="text-muted mb-0">@L["ReviewsAdminHelp"]</p>
    </div>
    <span class="badge bg-secondary">@L["TotalCount", Model.TotalItems]</span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>@L["User"]</th>
                <th>@L["ServiceName"]</th>
                <th>@L["Rating"]</th>
                <th>@L["Created"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.User?.Email</td>
                    <td>@item.Booking?.Service?.Name.Translate(culture)</td>
                    <td>@item.Rating / 5</td>
                    <td>@item.From.ToLocalTime()</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">@L["Delete"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml" model="Model"/>
</div>
