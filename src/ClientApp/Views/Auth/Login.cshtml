@model LoginViewModel

<h1>@L["Login"]</h1>

<form asp-action="Login" method="post" class="mt-3 col-md-6">
    <input type="hidden" asp-for="ReturnUrl"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">@L["Email"]</label>
        <input asp-for="Email" class="form-control"/>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">@L["Password"]</label>
        <input asp-for="Password" class="form-control"/>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@L["Login"]</button>
</form>
