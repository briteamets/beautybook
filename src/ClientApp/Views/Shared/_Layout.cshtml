@using ClientApp.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["AppName"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@2.44.0/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClientApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bb-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Beauty<span>Book</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Providers" asp-action="Index">@L["Providers"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Salons" asp-action="Index">@L["Salons"]</a>
                        </li>
                        @if (Context.Session.HasUsableToken())
                        {
                            if (Context.Session.IsClient())
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        @L["MyAccount"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index">@L["Bookings"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Wizard">@L["BookNow"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index">@L["Payments"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Favorites" asp-action="Index">@L["MyFavorites"]</a></li>
                                    </ul>
                                </li>
                            }
                            if (Context.Session.IsProvider())
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        @L["MyAccount"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Schedule" asp-action="Index">@L["MySchedule"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Bookings" asp-action="ProviderBookings">@L["ProviderBookings"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Providers" asp-action="MyReviews">@L["MyReviews"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Services" asp-action="MyServices">@L["MyServices"]</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Providers" asp-action="EditProfile">@L["MyProfile"]</a></li>
                                    </ul>
                                </li>
                            }
                            @await Component.InvokeAsync("NotificationBell")
                        }
                        <partial name="_LanguageSelection" />
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (Context.Session.HasUsableToken())
                        {
                            var displayName = Context.Session.GetDisplayName();
                            if (!string.IsNullOrWhiteSpace(displayName))
                            {
                                <span class="text-muted small fw-semibold">@displayName</span>
                            }
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Logout"]</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Auth" asp-action="Register">@L["RegisterAsClient"]</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Auth" asp-action="RegisterProvider">@L["RegisterAsProvider"]</a>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Auth" asp-action="Login">@L["Login"]</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bb-footer">
        <div class="container">
            <span class="bb-footer-brand">Beauty<span>Book</span></span>
            <span class="bb-footer-copy">&copy; 2026</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
