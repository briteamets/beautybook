@model AdminUserResetPasswordViewModel

<h1 class="h3 mb-4">@L["ResetPassword"]</h1>

<form asp-action="ResetPassword" method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="Id" type="hidden"/>
        <p class="text-muted">@L["ResetPasswordConfirmation"]</p>
        <div class="mb-3">
            <label class="form-label">@L["Email"]</label>
            <input class="form-control" value="@Model.Email" disabled/>
        </div>
        <div class="mb-3">
            <label asp-for="TemporaryPassword" class="form-label">@L["TemporaryPassword"]</label>
            <input asp-for="TemporaryPassword" class="form-control"/>
            <span asp-validation-for="TemporaryPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">@L["Cancel"]</a>
        <button type="submit" class="btn btn-warning">@L["ResetPassword"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
