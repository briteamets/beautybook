@{
    ViewData["Title"] = "Application Pending";
}

<div class="bb-auth-wrap" style="max-width:520px">
    <div class="bb-auth-card text-center">
        <div class="display-4 mb-2">&#9203;</div>
        <div class="bb-auth-brand">Beauty<span>Book</span></div>
        <div class="bb-auth-title mt-2">@L["ProviderPendingTitle"]</div>
        <p class="text-muted" style="font-size:0.9rem">@L["ProviderPendingMessage"]</p>

        <div class="text-start mt-3 p-3 rounded-3" style="background:var(--bb-primary-light)">
            <strong class="small" style="color:var(--bb-primary-text)">@L["WhatHappensNext"]</strong>
            <ul class="mb-0 mt-2 small" style="color:var(--bb-primary-text)">
                <li>@L["ProviderPendingStep1"]</li>
                <li>@L["ProviderPendingStep2"]</li>
                <li>@L["ProviderPendingStep3"]</li>
            </ul>
        </div>

        <div class="text-start mt-3 p-3 rounded-3" style="background:var(--bb-amber-light)">
            <strong class="small" style="color:var(--bb-amber-text)">@L["ProviderApprovalNoticeTitle"]</strong>
            <p class="mb-0 mt-1 small" style="color:var(--bb-amber-text)">@L["ProviderApprovalNoticeBody"]</p>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@L["BrowseProviders"]</a>
            <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary">@L["Bookings"]</a>
        </div>
    </div>
</div>
