@model Review
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h3">@L["DeleteReview"]</h1>
        <p class="text-muted">@L["DeleteReviewHelp"]</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">@L["User"]</dt>
            <dd class="col-sm-9">@Model.User?.Email</dd>
            <dt class="col-sm-3">@L["ServiceName"]</dt>
            <dd class="col-sm-9">@Model.Booking?.Service?.Name.Translate(culture)</dd>
            <dt class="col-sm-3">@L["Comment"]</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Comment) ? Model.Comment : "-")</dd>
        </dl>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id"/>
            <button type="submit" class="btn btn-danger">@L["Delete"]</button>
        </form>
    </div>
</div>
