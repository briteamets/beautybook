@model ProviderProfileEditViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["EditProfile"]</h1>
        <p class="text-muted mb-0">@L["DisplayName"]</p>
    </div>
    <a class="btn btn-outline-secondary" asp-area="ServiceProvider" asp-controller="Dashboard" asp-action="Index">@L["Back"]</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ProfileName" class="form-label fw-semibold">@L["DisplayName"]</label>
                <input asp-for="ProfileName" class="form-control" placeholder="e.g. Maria – Hair Stylist"/>
                <span asp-validation-for="ProfileName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label fw-semibold">@L["Address"]</label>
                <input asp-for="Address" class="form-control"/>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label fw-semibold">@L["Bio"]</label>
                <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProfilePictureUrl" class="form-label fw-semibold">@L["ProfilePictureUrl"]</label>
                <input asp-for="ProfilePictureUrl" class="form-control" type="url" placeholder="https://..."/>
                <span asp-validation-for="ProfilePictureUrl" class="text-danger small"></span>
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                {
                    <div class="mt-2">
                        <img src="@Model.ProfilePictureUrl" alt="@L["ProfilePicturePreview"]" class="rounded" style="max-height:120px; max-width:120px; object-fit:cover;"/>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@L["SaveChanges"]</button>
                <a class="btn btn-outline-secondary" asp-area="ServiceProvider" asp-controller="Dashboard" asp-action="Index">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
