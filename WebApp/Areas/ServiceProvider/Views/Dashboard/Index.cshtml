@model DashboardViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@L["Dashboard"]</h1>
        <p class="text-muted mb-0">@Model.ProviderName</p>
    </div>
    <a class="btn btn-primary" asp-controller="Services" asp-action="Index">@L["MyServices"]</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">@L["ActiveServices"]</div>
                <div class="display-6">@Model.ActiveServicesCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">@L["PendingRequests"]</div>
                <div class="display-6">@Model.PendingBookingsCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">@L["CompletedBookings"]</div>
                <div class="display-6">@Model.CompletedBookingsCount</div>
            </div>
        </div>
    </div>
</div>
