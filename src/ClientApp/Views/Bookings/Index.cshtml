@model BookingIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@L["Bookings"]</h1>
    <a class="btn btn-primary" asp-action="Wizard">@L["BookNow"]</a>
</div>

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        @L["NoBookingsYet"]
        <a asp-action="Wizard" class="alert-link ms-1">@L["BookNow"]</a>
    </div>
}
else
{
    var upcoming = Model.Bookings.Where(b => b.AppointmentDateTime >= DateTime.Now && b.Status != "Cancelled").OrderBy(b => b.AppointmentDateTime).ToList();
    var past = Model.Bookings.Where(b => b.AppointmentDateTime < DateTime.Now || b.Status == "Cancelled").OrderByDescending(b => b.AppointmentDateTime).ToList();

    @if (upcoming.Any())
    {
        <h5 class="text-muted mb-3">@L["Upcoming"]</h5>
        <div class="list-group mb-4">
            @foreach (var booking in upcoming)
            {
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold">@booking.ServiceName</div>
                            <div class="text-muted small">@booking.ProviderName</div>
                            <div class="mt-1 small">@booking.AppointmentDateTime.ToString("f")</div>
                        </div>
                        <div class="text-end ms-3 flex-shrink-0">
                            @{
                                var badgeClass = booking.Status switch {
                                    "Confirmed"  => "bg-success",
                                    "Pending"    => "bg-warning text-dark",
                                    "Cancelled"  => "bg-secondary",
                                    "Completed"  => "bg-primary",
                                    _            => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass mb-2 d-block">@L[booking.Status]</span>
                            <div class="fw-bold small">@booking.TotalPrice.ToString("0.00") EUR</div>
                            <div class="mt-2 d-flex gap-1 justify-content-end flex-wrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@booking.Id">@L["Details"]</a>
                                @if (!booking.IsPaid && booking.Status == "Pending")
                                {
                                    <a class="btn btn-sm btn-success" asp-action="Details" asp-route-id="@booking.Id">@L["PayNow"]</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (past.Any())
    {
        <h5 class="text-muted mb-3">@L["Past"]</h5>
        <div class="list-group">
            @foreach (var booking in past)
            {
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold">@booking.ServiceName</div>
                            <div class="text-muted small">@booking.ProviderName</div>
                            <div class="mt-1 small text-muted">@booking.AppointmentDateTime.ToString("f")</div>
                        </div>
                        <div class="text-end ms-3 flex-shrink-0">
                            @{
                                var badgeClass2 = booking.Status switch {
                                    "Confirmed"  => "bg-success",
                                    "Pending"    => "bg-warning text-dark",
                                    "Cancelled"  => "bg-secondary",
                                    "Completed"  => "bg-primary",
                                    _            => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass2 mb-2 d-block">@L[booking.Status]</span>
                            <div class="fw-bold small">@booking.TotalPrice.ToString("0.00") EUR</div>
                            <div class="mt-2 d-flex gap-1 justify-content-end flex-wrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@booking.Id">@L["Details"]</a>
                                @if (booking.Status == "Completed" && !booking.HasReview)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Review" asp-route-id="@booking.Id">@L["LeaveReview"]</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
