@model AdminUserConfirmActionViewModel

<h1 class="h3 mb-4">@L["ForceLogout"]</h1>

<form asp-action="ForceLogout" method="post" class="card shadow-sm">
    <div class="card-body">
        <input name="id" value="@Model.Id" type="hidden"/>
        <p>@Model.ConfirmText</p>
        <p class="fw-semibold mb-0">@Model.Email</p>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">@L["Cancel"]</a>
        <button type="submit" class="btn btn-danger">@L["ForceLogout"]</button>
    </div>
</form>
