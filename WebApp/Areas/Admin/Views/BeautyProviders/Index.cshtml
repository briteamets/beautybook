@model PagedViewModel<ProviderIndexItem>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["ServiceProviders"]</h1>
        <p class="text-muted mb-0">@L["BeautyProvidersAdminHelp"]</p>
    </div>
    <span class="badge bg-secondary">@L["TotalCount", Model.TotalItems]</span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Email"]</th>
                <th>@L["Status"]</th>
                <th>@L["Services"]</th>
                <th>@L["Bookings"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                            @(item.IsActive ? L["Active"] : L["Suspended"])
                        </span>
                    </td>
                    <td>@item.ServiceCount</td>
                    <td>@item.BookingCount</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml" model="Model"/>
</div>
