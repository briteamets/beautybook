@model BookingIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["Bookings"]</h1>
        <p class="text-muted mb-0">@L["BookingsAdminHelp"]</p>
    </div>
    <span class="badge bg-secondary">@L["TotalCount", Model.Page.TotalItems]</span>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="status">@L["Status"]</label>
            <select class="form-select" id="status" name="status">
                <option value="">@L["All"]</option>
                <option value="@Booking.StatusPending" selected="@(Model.Filter.Status == Booking.StatusPending ? "selected" : null)">@L[Booking.StatusPending]</option>
                <option value="@Booking.StatusConfirmed" selected="@(Model.Filter.Status == Booking.StatusConfirmed ? "selected" : null)">@L[Booking.StatusConfirmed]</option>
                <option value="@Booking.StatusCompleted" selected="@(Model.Filter.Status == Booking.StatusCompleted ? "selected" : null)">@L[Booking.StatusCompleted]</option>
                <option value="@Booking.StatusCancelled" selected="@(Model.Filter.Status == Booking.StatusCancelled ? "selected" : null)">@L[Booking.StatusCancelled]</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="dateFrom">@L["DateFrom"]</label>
            <input class="form-control" id="dateFrom" name="dateFrom" type="date" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"/>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="dateTo">@L["DateTo"]</label>
            <input class="form-control" id="dateTo" name="dateTo" type="date" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")"/>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="providerId">@L["Provider"]</label>
            <select class="form-select" id="providerId" name="providerId">
                <option value="">@L["All"]</option>
                @foreach (var provider in Model.Providers)
                {
                    <option value="@provider.Value" selected="@(provider.Selected ? "selected" : null)">@provider.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="serviceTypeId">@L["ServiceType"]</label>
            <select class="form-select" id="serviceTypeId" name="serviceTypeId">
                <option value="">@L["All"]</option>
                @foreach (var serviceType in Model.ServiceTypes)
                {
                    <option value="@serviceType.Value" selected="@(serviceType.Selected ? "selected" : null)">@serviceType.Text</option>
                }
            </select>
        </div>
        <div class="col-md-10">
            <label class="form-label" for="providerSearch">@L["ProviderSearch"]</label>
            <input class="form-control" id="providerSearch" name="providerSearch" value="@Model.Filter.ProviderSearch"/>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">@L["Filter"]</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>@L["Customer"]</th>
                <th>@L["Provider"]</th>
                <th>@L["ServiceType"]</th>
                <th>@L["Date"]</th>
                <th>@L["StartTime"]</th>
                <th>@L["EndTime"]</th>
                <th>@L["Status"]</th>
                <th>@L["Created"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Page.Items.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">@L["NoResultsFound"]</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Page.Items)
                {
                    var statusClass = item.Status switch
                    {
                        Booking.StatusPending => "bg-warning text-dark",
                        Booking.StatusConfirmed => "bg-primary",
                        Booking.StatusCompleted => "bg-success",
                        Booking.StatusCancelled => "bg-danger",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td>@item.ClientName</td>
                        <td>@item.ProviderName</td>
                        <td>@item.ServiceName</td>
                        <td>@item.BookingDate</td>
                        <td>@item.StartTime</td>
                        <td>@item.EndTime</td>
                        <td><span class="badge @statusClass">@L[item.Status]</span></td>
                        <td>@item.CreatedAt.ToLocalTime()</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml" model="Model.Page"/>
</div>
