@model ProviderFormViewModel

<h2 class="mb-4">@L["MyProfile"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @L["ProfileSaved"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SetupRequired"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @L["SetupRequiredBanner"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (Model.Id == null)
{
    <div class="alert alert-info">
        @L["ProfileSetupHint"]
    </div>
}

<div class="col-md-7">
    <form asp-action="EditProfile" method="post">
        <input type="hidden" asp-for="Id"/>
        <partial name="_ProviderForm" model="Model"/>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">@L["Save"]</button>
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">@L["Back"]</a>
        </div>
    </form>
</div>
