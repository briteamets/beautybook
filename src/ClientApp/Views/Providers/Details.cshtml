@using ClientApp.Services
@model ProviderDetailsViewModel

<div class="d-flex justify-content-between align-items-start mb-3">
    <h1 class="mb-0">@Model.ProfileName</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">@L["Back"]</a>
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">@L["Address"]</dt>
    <dd class="col-sm-9">@Model.Address</dd>
    @if (!string.IsNullOrWhiteSpace(Model.Bio))
    {
        <dt class="col-sm-3">@L["Bio"]</dt>
        <dd class="col-sm-9">@Model.Bio</dd>
    }
    <dt class="col-sm-3">@L["Rating"]</dt>
    <dd class="col-sm-9">&#9733; @Model.AverageRating.ToString("0.0") / 5 (@Model.ReviewCount)</dd>
</dl>

@if (Context.Session.IsClient())
{
    <div class="d-flex gap-3 mb-4 flex-wrap">
        @if (!Model.SalonId.HasValue)
        {
            <form asp-controller="Bookings" asp-action="WizardStep1Post" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="providerId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary btn-lg">@L["BookNow"]</button>
            </form>
        }
        else
        {
            <a asp-controller="Salons" asp-action="Details" asp-route-id="@Model.SalonId"
               class="btn btn-primary btn-lg">@L["BookViaSalon"]</a>
            <a asp-controller="Salons" asp-action="Details" asp-route-id="@Model.SalonId"
               class="btn btn-outline-secondary btn-lg">@L["ViewSalon"]</a>
        }
        @if (Model.IsFavorited)
        {
            <form asp-controller="Favorites" asp-action="Remove" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.FavoriteId" />
                <input type="hidden" name="returnProviderId" value="@Model.Id" />
                <button type="submit" class="btn btn-warning btn-lg">&#9733; @L["RemoveFromFavorites"]</button>
            </form>
        }
        else
        {
            <form asp-controller="Favorites" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="providerId" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-warning btn-lg">&#9734; @L["AddToFavorites"]</button>
            </form>
        }
    </div>
}
else if (!Context.Session.HasUsableToken())
{
    <div class="d-flex gap-3 mb-4 flex-wrap">
        <a asp-controller="Auth" asp-action="Login"
           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
           class="btn btn-primary btn-lg">@L["Login"]</a>
        @if (Model.SalonId.HasValue)
        {
            <a asp-controller="Salons" asp-action="Details" asp-route-id="@Model.SalonId"
               class="btn btn-outline-secondary btn-lg">@L["ViewSalon"]</a>
        }
    </div>
}

<h4>@L["Reviews"]</h4>

@if (!Model.Reviews.Any())
{
    <p class="text-muted">@L["NoReviews"]</p>
}
else
{
    <div class="list-group">
        @foreach (var review in Model.Reviews)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <span>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="@(i <= review.Rating ? "text-warning" : "text-muted")">&#9733;</span>
                        }
                        <strong class="ms-1">@review.UserName</strong>
                    </span>
                    <small class="text-muted">@review.CreatedAt.ToString("yyyy-MM-dd")</small>
                </div>
                @if (!string.IsNullOrWhiteSpace(review.Comment))
                {
                    <p class="mb-0 mt-1">@review.Comment</p>
                }
                else
                {
                    <p class="mb-0 mt-1 text-muted fst-italic">@L["CommentRemovedByProvider"]</p>
                }
            </div>
        }
    </div>
}
