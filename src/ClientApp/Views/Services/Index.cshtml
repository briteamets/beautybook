@model ServiceIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@L["Services"]</h1>
    <a class="btn btn-primary" asp-action="Create">@L["Create"]</a>
</div>

@if (!Model.Services.Any())
{
    <div class="alert alert-info">@L["NoRows"]</div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Category"]</th>
            <th>@L["Price"]</th>
            <th>@L["Status"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var service in Model.Services)
        {
            <tr>
                <td>@service.Name</td>
                <td>@service.CategoryName</td>
                <td>@service.Price.ToString("0.00") EUR</td>
                <td>@(service.IsActive ? L["Active"] : "")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@service.Id">@L["Details"]</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@service.Id">@L["Edit"]</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@service.Id">@L["Delete"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
