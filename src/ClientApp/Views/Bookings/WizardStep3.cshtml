@model WizardStep3ViewModel

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Wizard">@L["ChooseProvider"]</a></li>
        <li class="breadcrumb-item"><a asp-action="WizardStep2">@L["ChooseService"]</a></li>
        <li class="breadcrumb-item active">@L["ChooseDate"]</li>
    </ol>
</nav>

<h2 class="mb-1">@L["ChooseDate"]</h2>
<p class="text-muted mb-4">@Model.ProviderName &mdash; @Model.ServiceName</p>

<form asp-action="WizardStep3Post" method="post" style="max-width: 320px;">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label fw-semibold">@L["Date"]</label>
        <input type="date" name="date" class="form-control"
               value="@(Model.Date?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))"
               min="@DateTime.Today.ToString("yyyy-MM-dd")"
               required />
    </div>
    <button type="submit" class="btn btn-primary">@L["Next"]</button>
</form>
