@model ReviewCreateViewModel
@{
    ViewData["Title"] = L["LeaveReview"];
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-4">@L["LeaveReview"]</h1>
        <p class="mb-1"><strong>@Model.ProviderName</strong></p>
        <p class="text-muted">@Model.ProviderAddress</p>
        <p class="mb-4">@Model.ServiceName · @Model.AppointmentDateTime.ToLocalTime()</p>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input asp-for="BookingId" type="hidden"/>
            <div class="mb-3">
                <label class="form-label d-block">@L["Rating"]</label>
                <div class="d-flex flex-row-reverse justify-content-end gap-1 star-picker">
                    @for (var i = 5; i >= 1; i--)
                    {
                        <input class="btn-check" type="radio" asp-for="Rating" id="star-@i" value="@i"/>
                        <label class="btn btn-outline-warning" for="star-@i">★</label>
                    }
                </div>
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@L["Submit"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
