@model PagedViewModel<Salon>
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["Salons"]</h1>
        <p class="text-muted mb-0">@L["SalonsAdminHelp"]</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@L["CreateSalon"]</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Address"]</th>
                <th>@L["Staff"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">@L["NoResultsFound"]</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Name.Translate(culture)</td>
                        <td>@item.Address</td>
                        <td>@(item.Staff?.Count(st => st.To == null) ?? 0)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">@L["Delete"]</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml" model="Model"/>
</div>
