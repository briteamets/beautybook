@model LoginViewModel

<div class="bb-auth-wrap">
    <div class="bb-auth-card">
        <div class="bb-auth-brand">Beauty<span>Book</span></div>
        <div class="bb-auth-title">@L["Login"]</div>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl"/>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold">@L["Email"]</label>
                <input asp-for="Email" class="form-control"/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold">@L["Password"]</label>
                <input asp-for="Password" class="form-control"/>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-1">@L["Login"]</button>
        </form>

        <div class="bb-auth-footer">
            @L["NoAccount"]
            <a asp-action="Register">@L["RegisterAsClient"]</a>
            &nbsp;·&nbsp;
            <a asp-action="RegisterProvider">@L["RegisterAsProvider"]</a>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
