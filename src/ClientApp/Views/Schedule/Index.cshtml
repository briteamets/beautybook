@model ScheduleIndexViewModel

<h2 class="mb-4">@L["ScheduleSetup"]</h2>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @L[Model.SuccessMessage]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">

    @* Weekly schedule *@
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold">@L["WeeklySchedule"]</div>
            <div class="card-body">
                <form asp-action="SaveSchedule" method="post">
                    @Html.AntiForgeryToken()
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["Day"]</th>
                                    <th>@L["WorkingDay"]</th>
                                    <th>@L["StartTime"]</th>
                                    <th>@L["EndTime"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Days.Count; i++)
                                {
                                    var day = Model.Days[i];
                                    <tr>
                                        <td>
                                            <input type="hidden" name="Days[@i].DayOfWeek" value="@((int)day.DayOfWeek)" />
                                            <strong>@L[day.DayOfWeek.ToString()]</strong>
                                        </td>
                                        <td>
                                            <input type="hidden" name="Days[@i].IsWorkingDay" value="false" />
                                            <input type="checkbox" name="Days[@i].IsWorkingDay" value="true"
                                                   class="form-check-input"
                                                   @(day.IsWorkingDay ? "checked" : "") />
                                        </td>
                                        <td>
                                            <input type="time" name="Days[@i].StartTime" class="form-control form-control-sm"
                                                   style="max-width:130px"
                                                   value="@day.StartTime.ToString(@"hh\:mm")" />
                                        </td>
                                        <td>
                                            <input type="time" name="Days[@i].EndTime" class="form-control form-control-sm"
                                                   style="max-width:130px"
                                                   value="@day.EndTime.ToString(@"hh\:mm")" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="submit" class="btn btn-primary">@L["Save"]</button>
                </form>
            </div>
        </div>
    </div>

    @* Breaks *@
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold">@L["Breaks"]</div>
            <div class="card-body">
                @if (Model.Breaks.Count == 0)
                {
                    <p class="text-muted small mb-3">@L["NoRows"]</p>
                }
                else
                {
                    <div class="list-group mb-3">
                        @foreach (var b in Model.Breaks)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <strong>@L[b.DayOfWeek.ToString()]</strong>
                                    &mdash; @b.BreakStart.ToString(@"hh\:mm") – @b.BreakEnd.ToString(@"hh\:mm")
                                </span>
                                <form asp-action="RemoveBreak" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["RemoveBreak"]</button>
                                </form>
                            </div>
                        }
                    </div>
                }

                <h6 class="mb-2">@L["AddBreak"]</h6>
                <form asp-action="AddBreak" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-auto">
                        <select name="DayOfWeek" class="form-select form-select-sm">
                            @foreach (var dow in Enum.GetValues<DayOfWeek>())
                            {
                                <option value="@((int)dow)">@L[dow.ToString()]</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-1">@L["BreakStart"]</label>
                        <input type="time" name="BreakStart" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-1">@L["BreakEnd"]</label>
                        <input type="time" name="BreakEnd" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-auto mt-3">
                        <button type="submit" class="btn btn-sm btn-outline-primary">@L["AddBreak"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* Generate slots *@
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold">@L["GenerateSlots"]</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.GenerateResult))
                {
                    <div class="alert alert-success">
                        @string.Format(L["SlotsGenerated"].Value, Model.GenerateResult)
                    </div>
                }
                <form asp-action="GenerateSlots" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-auto">
                        <label class="form-label small mb-1">@L["From"]</label>
                        <input type="date" name="FromDate" class="form-control form-control-sm"
                               value="@Model.GenerateForm.FromDate.ToString("yyyy-MM-dd")"
                               min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-1">@L["To"]</label>
                        <input type="date" name="ToDate" class="form-control form-control-sm"
                               value="@Model.GenerateForm.ToDate.ToString("yyyy-MM-dd")"
                               min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-auto mt-3">
                        <button type="submit" class="btn btn-success">@L["GenerateSlots"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* Upcoming slots *@
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold">@L["UpcomingSlots"]</div>
            <div class="card-body">
                @if (Model.UpcomingSlots.Count == 0)
                {
                    <p class="text-muted">@L["NoUpcomingSlots"]</p>
                }
                else
                {
                    @foreach (var group in Model.UpcomingSlots.GroupBy(s => s.Date))
                    {
                        <h6 class="mt-3 mb-1 text-secondary">@group.Key.ToString("yyyy-MM-dd")</h6>
                        <div class="list-group mb-2">
                            @foreach (var slot in group)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center @(slot.IsBooked ? "text-muted" : "")">
                                    <span>@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</span>
                                    <div class="d-flex gap-2 align-items-center">
                                        @if (slot.IsBooked)
                                        {
                                            <span class="badge bg-warning text-dark">@L["Booked"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@L["Free"]</span>
                                            <form asp-action="DeleteSlot" method="post" class="d-inline"
                                                  onsubmit="return confirm('@L["ConfirmDelete"]')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@slot.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

</div>
