<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@L["ServiceProviderPortal"] - @L["AppName"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true"/>
</head>
<body>
<div class="container-fluid">
    <div class="row min-vh-100">
        <aside class="col-md-3 col-lg-2 border-end bg-light p-3">
            <a class="h4 text-decoration-none text-dark" asp-area="ServiceProvider" asp-controller="Dashboard" asp-action="Index">@L["ServiceProviderPortal"]</a>
            <nav class="nav flex-column mt-4 gap-1">
                <a class="nav-link" asp-area="ServiceProvider" asp-controller="Dashboard" asp-action="Index">@L["Dashboard"]</a>
                <a class="nav-link" asp-area="ServiceProvider" asp-controller="Schedule" asp-action="Index">@L["MySchedule"]</a>
                <a class="nav-link" asp-area="ServiceProvider" asp-controller="Services" asp-action="Index">@L["MyServices"]</a>
                <a class="nav-link" asp-area="ServiceProvider" asp-controller="Bookings" asp-action="Index">@L["Requests"]</a>
                <a class="nav-link" asp-area="ServiceProvider" asp-controller="Profile" asp-action="Edit">@L["EditProfile"]</a>
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Browse">@L["BackToSite"]</a>
            </nav>
        </aside>
        <main class="col-md-9 col-lg-10 p-4">
            <partial name="/Views/Shared/_FlashMessages.cshtml"/>
            @RenderBody()
        </main>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
