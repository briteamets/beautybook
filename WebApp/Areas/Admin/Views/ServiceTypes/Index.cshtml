@model ServiceTypeIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["ServiceCatalog"]</h1>
        <p class="text-muted mb-0">@L["ServiceCatalogAdminHelp"]</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@L["CreateServiceType"]</a>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="categoryId">@L["Category"]</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">@L["All"]</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value" selected="@(category.Selected ? "selected" : null)">@category.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="isActive">@L["Status"]</label>
            <select class="form-select" id="isActive" name="isActive">
                <option value="">@L["All"]</option>
                <option value="true" selected="@(Model.Filter.IsActive == true ? "selected" : null)">@L["Active"]</option>
                <option value="false" selected="@(Model.Filter.IsActive == false ? "selected" : null)">@L["Inactive"]</option>
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-primary">@L["Filter"]</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Category"]</th>
                <th>@L["Status"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Page.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.CategoryName</td>
                    <td>@(item.IsActive ? L["Active"] : L["Inactive"])</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                        <form asp-action="ToggleActive" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id"/>
                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(item.IsActive ? L["Deactivate"] : L["Activate"])
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml" model="Model.Page"/>
</div>
