@model ServiceCategoryFormViewModel
<h1 class="h3 mb-4">@L["EditServiceCategory"]</h1>

<form asp-action="Edit" method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="Id" type="hidden"/>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name.En" class="form-label">@L["NameEn"]</label>
                <input asp-for="Name.En" class="form-control"/>
                <span asp-validation-for="Name.En" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Name.Et" class="form-label">@L["NameEt"]</label>
                <input asp-for="Name.Et" class="form-control"/>
                <span asp-validation-for="Name.Et" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description.En" class="form-label">@L["DescriptionEn"]</label>
                <textarea asp-for="Description.En" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description.En" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description.Et" class="form-label">@L["DescriptionEt"]</label>
                <textarea asp-for="Description.Et" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description.Et" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input"/>
                    <label asp-for="IsActive" class="form-check-label">@L["Active"]</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@L["SaveChanges"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
