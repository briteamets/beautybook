@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Builder
@inject IOptions<RequestLocalizationOptions> LocalizationOptions
@{
    var cultureItems = LocalizationOptions.Value.SupportedUICultures!
        .Select(c => new
        {
            Value = c.Name,
            Text = c.TwoLetterISOLanguageName == "et" ? L["Estonian"] : L["English"]
        }).ToList();
}

<li class="nav-item d-flex align-items-center gap-2 ms-lg-3">
    <span class="small text-muted">@L["Language"]</span>
    @foreach (var item in cultureItems)
    {
        <a class="btn btn-sm @(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == item.Value ? "btn-dark" : "btn-outline-dark")"
           asp-area="" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="@item.Value"
           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
            @item.Text
        </a>
    }
</li>
