@model int

<li class="nav-item">
    <a class="nav-link text-dark position-relative" asp-controller="Notifications" asp-action="Index">
        &#128276;
        @if (Model > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="font-size:0.65rem">
                @Model
            </span>
        }
    </a>
</li>
