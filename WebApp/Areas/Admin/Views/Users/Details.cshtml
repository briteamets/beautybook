@model AdminUserDetailsViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["UserDetails"]</h1>
        <p class="text-muted mb-0">@Model.Email</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Back"]</a>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">@L["Edit"]</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">@L["Profile"]</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">@L["Id"]</dt>
                    <dd class="col-sm-8 text-break">@Model.Id</dd>
                    <dt class="col-sm-4">@L["Email"]</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">@L["Username"]</dt>
                    <dd class="col-sm-8">@Model.UserName</dd>
                    <dt class="col-sm-4">@L["PhoneNumber"]</dt>
                    <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.PhoneNumber) ? Model.PhoneNumber : "-")</dd>
                    <dt class="col-sm-4">@L["RegisteredDate"]</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime()</dd>
                    <dt class="col-sm-4">@L["Status"]</dt>
                    <dd class="col-sm-8">@(Model.IsActive ? L["Active"] : L["Inactive"])</dd>
                    <dt class="col-sm-4">@L["ProviderApplication"]</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsProviderApplicant)
                        {
                            <span class="badge bg-info text-dark">@L["WantsToBeProvider"]</span>
                        }
                        else
                        {
                            <span>@L["No"]</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5">@L["Security"]</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-5">@L["Roles"]</dt>
                    <dd class="col-sm-7">@(Model.Roles.Count == 0 ? "-" : string.Join(", ", Model.Roles))</dd>
                    <dt class="col-sm-5">@L["Confirmed"]</dt>
                    <dd class="col-sm-7">@(Model.EmailConfirmed ? L["Yes"] : L["No"])</dd>
                    <dt class="col-sm-5">@L["TwoFactorEnabled"]</dt>
                    <dd class="col-sm-7">@(Model.TwoFactorEnabled ? L["Yes"] : L["No"])</dd>
                    <dt class="col-sm-5">@L["AccessFailedCount"]</dt>
                    <dd class="col-sm-7">@Model.AccessFailedCount</dd>
                </dl>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-body d-flex flex-wrap gap-2">
                <a class="btn btn-outline-warning" asp-action="ResetPassword" asp-route-id="@Model.Id">@L["ResetPassword"]</a>
                <a class="btn btn-outline-danger" asp-action="ForceLogout" asp-route-id="@Model.Id">@L["ForceLogout"]</a>
            </div>
        </div>
    </div>
</div>
