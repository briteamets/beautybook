@model WizardStep2ViewModel

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Wizard">@L["ChooseProvider"]</a></li>
        <li class="breadcrumb-item active">@L["ChooseService"]</li>
    </ol>
</nav>

<h2 class="mb-1">@L["ChooseService"]</h2>
<p class="text-muted mb-3">@Model.ProviderName</p>

@if (Model.ServiceTypes.Any())
{
    <div class="btn-group mb-4 flex-wrap" role="group">
        <a href="@Url.Action("WizardStep2")"
           class="btn btn-@(Model.ServiceTypeId == null ? "primary" : "outline-primary")">@L["AllServiceTypes"]</a>
        @foreach (var st in Model.ServiceTypes)
        {
            <a href="@Url.Action("WizardStep2", new { serviceTypeId = st.Id })"
               class="btn btn-@(Model.ServiceTypeId == st.Id ? "primary" : "outline-primary")">@st.Name</a>
        }
    </div>
}

@if (!Model.Services.Any())
{
    <div class="alert alert-info">@L["NoRows"]</div>
}
else
{
    <div class="list-group">
        @foreach (var service in Model.Services)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1">@service.Name</h6>
                        @if (!string.IsNullOrWhiteSpace(service.Description))
                        {
                            <small class="text-muted d-block">@service.Description</small>
                        }
                        <div class="mt-1">
                            <span class="badge bg-secondary">@service.CategoryName</span>
                            <span class="text-muted ms-2 small">@service.DurationMinutes @L["Min"]</span>
                        </div>
                    </div>
                    <div class="text-end ms-3 flex-shrink-0">
                        <div class="fw-bold mb-1">@service.Price.ToString("0.00") EUR</div>
                        <form asp-action="WizardStep2Post" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="serviceId" value="@service.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">@L["Select"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
