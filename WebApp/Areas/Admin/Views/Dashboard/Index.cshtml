@model AdminDashboardViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["Dashboard"]</h1>
        <p class="text-muted mb-0">@L["AdminDashboardHelp"]</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">@L["TotalRegisteredUsers"]</div>
                <div class="display-6">@Model.TotalRegisteredUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">@L["TotalRegisteredServiceProviders"]</div>
                <div class="display-6">@Model.TotalServiceProviders</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">@L["TotalBookingsToday"]</div>
                <div class="display-6">@Model.TotalBookingsToday</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">@L["RecentActivity"]</h2>
    </div>
    <div class="list-group list-group-flush">
        @if (Model.RecentActivity.Count == 0)
        {
            <div class="list-group-item text-muted">@L["NoRecentActivity"]</div>
        }
        @foreach (var item in Model.RecentActivity)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <div class="fw-semibold">@L[item.ActivityType]</div>
                        <div>@item.PrimaryText</div>
                        <div class="text-muted small">@item.SecondaryText</div>
                    </div>
                    <div class="text-muted small">@item.Timestamp.ToLocalTime()</div>
                </div>
            </div>
        }
    </div>
</div>
