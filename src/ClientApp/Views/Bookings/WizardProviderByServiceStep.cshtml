@model WizardProviderByServiceStepViewModel

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-action="ServiceWizard"
               asp-route-salonId="@Model.SalonId"
               asp-route-salonName="@Model.SalonName">@L["ChooseCategory"]</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-action="ServiceWizardTypes"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-salonId="@Model.SalonId"
               asp-route-salonName="@Model.SalonName">@L["ChooseServiceType"]</a>
        </li>
        <li class="breadcrumb-item active">@Model.ServiceTypeName</li>
    </ol>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.SalonName))
{
    <p class="mb-2"><span class="badge bg-info text-dark">@Model.SalonName</span></p>
}

<h2 class="mb-1">@L["ChooseProvider"]</h2>
<p class="text-muted mb-4">@Model.ServiceTypeName</p>

@if (!Model.Providers.Any())
{
    <div class="alert alert-info">@L["NoProvidersForService"]</div>
    <a asp-action="ServiceWizardTypes"
       asp-route-categoryId="@Model.CategoryId"
       asp-route-salonId="@Model.SalonId"
       asp-route-salonName="@Model.SalonName"
       class="btn btn-outline-secondary">@L["Back"]</a>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var provider in Model.Providers)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@provider.ProfileName</h5>
                        <p class="card-text text-muted small">@provider.Address</p>
                        <p class="card-text">
                            <span>&#9733; @provider.AverageRating.ToString("0.0")</span>
                            &nbsp;&bull;&nbsp;
                            <span class="text-success">@provider.TodayAvailabilityCount @L["SlotsToday"]</span>
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <form asp-action="WizardStep1Post" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="providerId"    value="@provider.Id" />
                            <input type="hidden" name="serviceTypeId" value="@Model.ServiceTypeId" />
                            <input type="hidden" name="salonId"       value="@Model.SalonId" />
                            <input type="hidden" name="salonName"     value="@Model.SalonName" />
                            <button type="submit" class="btn btn-sm btn-primary">@L["Select"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
