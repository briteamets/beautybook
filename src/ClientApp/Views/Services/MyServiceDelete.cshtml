@model ServiceListItemViewModel

<h2>@L["Delete"] @L["Service"]</h2>
<p class="alert alert-warning">@L["ConfirmDelete"]</p>

<dl class="row">
    <dt class="col-sm-3">@L["Name"]</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">@L["Category"]</dt>
    <dd class="col-sm-9">@Model.CategoryName</dd>
    <dt class="col-sm-3">@L["Price"]</dt>
    <dd class="col-sm-9">@Model.Price.ToString("0.00") €</dd>
    <dt class="col-sm-3">@L["DurationMinutes"]</dt>
    <dd class="col-sm-9">@Model.DurationMinutes @L["Min"]</dd>
</dl>

<form asp-action="MyServiceDelete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">@L["Delete"]</button>
    <a asp-action="MyServices" class="btn btn-outline-secondary">@L["Cancel"]</a>
</form>
