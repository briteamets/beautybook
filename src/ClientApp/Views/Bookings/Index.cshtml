@model BookingIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@L["Bookings"]</h1>
    <a class="btn btn-primary" asp-action="Create">@L["Create"]</a>
</div>

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">@L["NoRows"]</div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@L["Service"]</th>
            <th>@L["Provider"]</th>
            <th>@L["Appointment"]</th>
            <th>@L["Status"]</th>
            <th>@L["Total"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var booking in Model.Bookings)
        {
            <tr>
                <td>@booking.ServiceName</td>
                <td>@booking.ProviderName</td>
                <td>@booking.AppointmentDateTime.ToString("g")</td>
                <td>@booking.Status</td>
                <td>@booking.TotalPrice.ToString("0.00") EUR</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@booking.Id">@L["Details"]</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@booking.Id">@L["Edit"]</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@booking.Id">@L["Delete"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
