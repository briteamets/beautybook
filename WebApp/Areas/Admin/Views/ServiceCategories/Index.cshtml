@model ServiceCategoryIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["Categories"]</h1>
        <p class="text-muted mb-0">@L["ServiceCategoriesAdminHelp"]</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@L["CreateCategory"]</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Status"]</th>
                <th>@L["ServiceTypes"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Page.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                            @(item.IsActive ? L["Active"] : L["Inactive"])
                        </span>
                    </td>
                    <td>@item.ServiceTypeCount</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                        <form asp-action="ToggleActive" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id"/>
                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(item.IsActive ? L["Deactivate"] : L["Activate"])
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml" model="Model.Page"/>
</div>
