@model ProviderServiceFormViewModel

<h1>@L["EditService"]</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
    <input type="hidden" asp-for="Id"/>
    <partial name="_ServiceForm" model="Model"/>
    <button type="submit" class="btn btn-primary">@L["Save"]</button>
    <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
</form>
